{
  "functions": {
    "api/data.js": {
      "includeFiles": "data/**"
    }
  },
  "routes": [
    { "src": "/data/dados\\.json", "dest": "/api/data?file=dados" },
    { "src": "/data/detalhe-mes\\.json", "dest": "/api/data?file=detalhe" },
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    { "handle": "filesystem" }
  ]
}
