{
  "cleanUrls": true,
  "functions": {
    "api/data.js": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/data/dados.json", "destination": "/api/data?file=dados" },
    { "source": "/data/detalhe-mes.json", "destination": "/api/data?file=detalhe" }
  ]
}
