// pbi_extract.js — Extrai dados do relatorio Power BI "[PCP] Perda de Receita - BK PLK"
// via Chrome depuravel (CDP 127.0.0.1:9222), sessao ja logada pelo usuario.
//
// Saida:
//   C:\projetos\perdadereceita\pbi_raw\{aba}-AAAAMMDD.txt  (innerText integral por aba)
//   C:\projetos\perdadereceita\pbi_raw\resumo-AAAAMMDD.json (dados estruturados)
//
// NAO envia WhatsApp, NAO toca em dados.json, NAO fecha o Chrome nem a aba.
// Exit code 0 = sucesso; != 0 = falha (para o agendador detectar).

const fs = require('fs');
const path = require('path');
// Playwright esta instalado no projeto irmao certponto-report.
const { chromium } = require('C:\\projetos\\certponto-report\\node_modules\\playwright');

const RAW_DIR = 'C:\\projetos\\perdadereceita\\pbi_raw';
const CDP = 'http://127.0.0.1:9222';
const WAIT_RENDER_MS = 12000;   // espera apos trocar de aba (Power BI demora)
const RELOAD_TIMEOUT_MS = 60000;

function agora() { return new Date().toISOString(); }
function logInfo(msg, extra) { console.log(JSON.stringify({ ts: agora(), level: 'info', msg, ...extra })); }
function logErro(msg, extra) { console.error(JSON.stringify({ ts: agora(), level: 'error', msg, ...extra })); }
function fatal(msg, extra) { logErro(msg, extra); process.exit(1); }

function stampData() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, '0');
  return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}`;
}

// Normaliza quebras de encoding conhecidas nos nomes de regional
// (innerText as vezes vem com mojibake: "BK A% FOGO LESTE" -> "BK É FOGO LESTE").
function normalizarRegional(nome) {
  return String(nome)
    .replace(/BK A% FOGO/gi, 'BK É FOGO')
    .replace(/A%/g, 'É')
    .replace(/\s+/g, ' ')
    .trim();
}

async function innerTextFrame(frame) {
  return frame.locator('body').innerText({ timeout: 15000 });
}

// Espera adaptativa: ate o texto conter o marcador, ou timeout.
async function esperarTexto(frame, marcador, timeoutMs) {
  const inicio = Date.now();
  let txt = '';
  while (Date.now() - inicio < timeoutMs) {
    try {
      txt = await innerTextFrame(frame);
      if (txt.toLowerCase().includes(marcador.toLowerCase())) return txt;
    } catch { /* frame ainda montando */ }
    await new Promise((r) => setTimeout(r, 2000));
  }
  throw new Error(`timeout ${timeoutMs}ms esperando texto "${marcador}"`);
}

// Clica numa aba do relatorio pelo texto (regex tolerante). Se o click direto
// falhar, tenta scrollIntoView (o menu lateral de paginas e uma lista vertical
// com scroll proprio) e clica de novo.
async function clicarAba(frame, nomeRegex, rotulo) {
  const alvo = frame.locator(`text=${nomeRegex}`).first();
  try {
    await alvo.click({ timeout: 10000 });
    logInfo('aba clicada', { aba: rotulo, modo: 'direto' });
    return;
  } catch (e1) {
    logInfo('click direto falhou, tentando scroll no menu de paginas', { aba: rotulo, erro: e1.message.slice(0, 160) });
  }
  try {
    await alvo.scrollIntoViewIfNeeded({ timeout: 10000 });
    await alvo.click({ timeout: 10000 });
    logInfo('aba clicada', { aba: rotulo, modo: 'scroll' });
    return;
  } catch (e2) {
    throw new Error(`nao consegui clicar na aba "${rotulo}": ${e2.message.slice(0, 200)}`);
  }
}

// ---------- parsers ----------

// Tabela "Perda de receita por data" (aba inicial).
// Formato no innerText:
//   Perda de receita por data ... Row Selection \n DATA \n Dia da Semana \n
//   Perda Receita \n (%) Perda \n Select Row \n 8/1/2026 \n sabado \n R$ 211,829 \n 1.1% ...
//   Total \n R$ 3,031,411 \n 1.4%
function parsePorData(txt) {
  const marcador = 'Perda de receita por data';
  const i = txt.indexOf(marcador);
  if (i < 0) throw new Error('secao "Perda de receita por data" nao encontrada');
  // Limita a secao: termina na proxima tabela ("Perda de receita por subcategoria").
  const fim = txt.indexOf('Perda de receita por subcategoria', i);
  const secao = txt.slice(i, fim > i ? fim : i + 20000);
  const linhas = secao.split('\n').map((l) => l.trim());

  const linhaRe = /^(\d{1,2}\/\d{1,2}\/\d{4})$/;
  const dinheiroRe = /^R\$\s?[\d.,]+$/;
  const pctRe = /^[\d.,]+%$/;

  const porData = [];
  let total = null;
  for (let k = 0; k < linhas.length; k++) {
    const m = linhas[k].match(linhaRe);
    if (m && dinheiroRe.test(linhas[k + 2] || '') && pctRe.test(linhas[k + 3] || '')) {
      porData.push({
        data: m[1],
        diaSemana: linhas[k + 1] || null,
        perda: linhas[k + 2],
        pct: linhas[k + 3],
      });
      k += 3;
      continue;
    }
    if (linhas[k] === 'Total') {
      // Acha os dois proximos valores nao-vazios: perda total e pct total.
      const prox = linhas.slice(k + 1).filter((l) => l !== '');
      if (dinheiroRe.test(prox[0] || '') && pctRe.test(prox[1] || '')) {
        total = { perdaTotal: prox[0], pctTotal: prox[1] };
      }
      break;
    }
  }
  if (porData.length === 0) throw new Error('nenhuma linha de data extraida');
  if (!total) throw new Error('linha Total da tabela por data nao encontrada');
  return { porData, total };
}

// ---------- captura completa da tabela por-data (virtualizacao) ----------

// A tabela "Perda de receita por data" e virtualizada: so as linhas visiveis
// existem no DOM. Com mais de ~16 dias de dados, o innerText perde os dias
// finais. Aqui rolamos o conteiner da tabela ate o fim coletando TODAS as
// linhas, e depois mesclamos de volta no texto para o parsePorData ver tudo.
async function capturarLinhasPorData(frame) {
  return frame.evaluate(async () => {
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const dataRe = /^\d{1,2}\/\d{1,2}\/\d{4}$/;
    const dinRe = /^R\$\s?[\d.,]+$/;
    const pctRe = /^[\d.,]+%$/;
    // A tabela por-data e o conteiner rolavel cujas linhas seguem o padrao
    // data -> dia da semana -> R$ -> % (o titulo e um textbox SEPARADO e o
    // detalhe por loja nao tem coluna de dia da semana — por isso o padrao
    // completo identifica a tabela certa sem ambiguidade).
    const dataRe0 = /^\d{1,2}\/\d{1,2}\/\d{4}$/;
    const semRe = /^(sabado|domingo|segunda|terca|quarta|quinta|sexta)/i;
    const dinRe0 = /^R\$\s?[\d.,]+$/;
    const pctRe0 = /^[\d.,]+%$/;
    const candidatos = Array.from(document.querySelectorAll('div'))
      .filter((d) => d.scrollHeight > d.clientHeight + 40 && d.clientHeight > 100)
      .map((d) => {
        const ls = (d.innerText || '').split('\n').map((l) => l.trim());
        let n = 0;
        for (let k = 0; k < ls.length; k++) {
          if (dataRe0.test(ls[k]) && semRe.test(ls[k + 1] || '') && dinRe0.test(ls[k + 2] || '') && pctRe0.test(ls[k + 3] || '')) n++;
        }
        return { d, n };
      })
      .filter((x) => x.n >= 3)
      .sort((a, b) => b.n - a.n);
    const alvo = candidatos[0] && candidatos[0].d;
    if (!alvo) return { erro: 'conteiner da tabela por-data nao localizado', candidatos: candidatos.length };
    const linhas = new Map();
    let total = null;
    const coletar = () => {
      const ls = alvo.innerText.split('\n').map((l) => l.trim());
      for (let k = 0; k < ls.length; k++) {
        if (dataRe.test(ls[k]) && dinRe.test(ls[k + 2] || '') && pctRe.test(ls[k + 3] || '')) {
          if (!linhas.has(ls[k])) linhas.set(ls[k], [ls[k], ls[k + 1] || '', ls[k + 2], ls[k + 3]]);
        }
        if (ls[k] === 'Total') {
          const prox = ls.slice(k + 1).filter(Boolean);
          if (dinRe.test(prox[0] || '') && pctRe.test(prox[1] || '')) total = [prox[0], prox[1]];
        }
      }
    };
    alvo.scrollTop = 0;
    await sleep(900);
    let paradas = 0;
    while (paradas < 3) {
      coletar();
      const antes = alvo.scrollTop;
      alvo.scrollTop += Math.max(200, alvo.clientHeight - 80);
      await sleep(700);
      if (alvo.scrollTop === antes) paradas++; else paradas = 0;
    }
    coletar();
    alvo.scrollTop = 0;
    await sleep(400);
    return { linhas: Array.from(linhas.values()), total };
  });
}

// Substitui a secao "Perda de receita por data" do texto pelas linhas
// completas coletadas com scroll. Se a captura falhar ou nao agregar linhas
// novas, mantem o texto original.
async function mesclarPorDataCompleta(frame, txt) {
  try {
    const cap = await capturarLinhasPorData(frame);
    if (!cap || cap.erro || !cap.linhas || cap.linhas.length === 0) {
      logInfo('captura completa por-data indisponivel; usando texto simples', { erro: cap && cap.erro });
      return txt;
    }
    const dataRe = /^(\d{1,2}\/\d{1,2}\/\d{4})$/;
    const dinRe = /^R\$\s?[\d.,]+$/;
    const pctRe = /^[\d.,]+%$/;
    const ls = txt.split('\n').map((l) => l.trim());
    let jaTinha = 0;
    for (let k = 0; k < ls.length; k++) {
      if (dataRe.test(ls[k]) && dinRe.test(ls[k + 2] || '') && pctRe.test(ls[k + 3] || '')) jaTinha++;
    }
    if (cap.linhas.length <= jaTinha) {
      logInfo('captura completa nao agregou linhas novas', { capturadas: cap.linhas.length, texto: jaTinha });
      return txt;
    }
    let total = cap.total;
    if (!total) {
      try { total = parsePorData(txt).total; } catch { /* segue sem total do texto */ }
    }
    const i = txt.indexOf('Perda de receita por data');
    const fim = txt.indexOf('Perda de receita por subcategoria', i);
    const secao = 'Perda de receita por data\nDATA\nDia da Semana\nPerda Receita\n(%) Perda\n'
      + cap.linhas.map((r) => r.join('\n')).join('\n')
      + (total ? `\nTotal\n${total[0]}\n${total[1]}` : '') + '\n';
    logInfo('tabela por-data mesclada com scroll', { linhas: cap.linhas.length, antes: jaTinha, temTotal: !!total });
    return txt.slice(0, i) + secao + (fim > i ? txt.slice(fim) : '');
  } catch (e) {
    logErro('mescla por-data falhou; usando texto simples', { erro: e.message.slice(0, 200) });
    return txt;
  }
}

// Tabela "Impactos por regional 100% paradas (MTD)" (aba 01. Tab. resumo BKB).
// Cabecalhos (antes de CENTRO OESTE): Regional, MANUTENÇÃO, TI/TO, OUTROS,
// LABOR, TI/TO / MANUT, TOTAL. Cada linha: nome + 6 valores +
// "Additional Conditional Formatting".
function parseRegionalMtd(txt) {
  const marcador = /Impactos por regional 100% paradas \(MTD\)/i;
  const m = txt.match(marcador);
  if (!m) throw new Error('secao "Impactos por regional 100% paradas (MTD)" nao encontrada');
  let secao = txt.slice(m.index);
  // Termina na proxima secao conhecida ou num limite generoso.
  const fim = secao.search(/PARCIALMENTE PARADAS|Oportunidades di/i);
  if (fim > 0) secao = secao.slice(0, fim);
  const linhas = secao.split('\n').map((l) => l.trim()).filter((l) => l !== '');

  // Cabecalhos: linhas entre "Regional" e o primeiro nome de regional (CENTRO OESTE).
  const iReg = linhas.findIndex((l) => /^regional$/i.test(l));
  const iPrimeira = linhas.findIndex((l) => /CENTRO OESTE/i.test(l));
  if (iReg < 0 || iPrimeira < 0) throw new Error('cabecalho da tabela MTD por regional nao localizado');
  const cabecalhos = linhas.slice(iReg, iPrimeira).filter((l) => !/^(scroll|row selection)/i.test(l));

  const valorRe = /^(R\$\s?[\d.,]+|[\d.,]+)$/;
  const regionais = [];
  let k = iPrimeira;
  while (k < linhas.length) {
    const nome = linhas[k];
    const vals = [];
    let j = k + 1;
    while (j < linhas.length && valorRe.test(linhas[j]) && vals.length < 6) {
      vals.push(linhas[j]);
      j++;
    }
    if (vals.length < 2) break; // acabou a tabela
    // Desambiguacao de celula vazia: a coluna "TI/TO / MANUT" SEMPRE tem
    // decimal longo (ex.: "R$ 3,656.435738095") e TOTAL tem formato curto
    // ("R$ 41,125"). Se vierem 5 valores e o 5o for curto, a celula TI/TO /
    // MANUT estava vazia e os valores deslocaram -- realinha.
    const curtoRe = /^R\$\s?[\d,]+$/;
    if (vals.length === 5 && curtoRe.test(vals[4])) {
      vals.splice(4, 0, null); // TI/TO / MANUT ausente
    }
    const row = { regional: normalizarRegional(nome) };
    // cabecalhos[0] = "Regional"; os valores seguem cabecalhos[1..]
    for (let c = 1; c < cabecalhos.length && c - 1 < vals.length; c++) {
      if (vals[c - 1] !== null) row[cabecalhos[c]] = vals[c - 1];
    }
    regionais.push(row);
    // pula "Additional Conditional Formatting" se presente
    if (/additional conditional formatting/i.test(linhas[j] || '')) j++;
    k = j;
  }
  if (regionais.length === 0) throw new Error('nenhuma regional extraida da tabela MTD');
  return { cabecalhos, regionais };
}

function parseAtualizadoEm(txt) {
  const m = txt.match(/Atualizado em:\s*\n?\s*([^\n]+)/i);
  return m ? m[1].trim() : null;
}

// ---------- slicer Regional (button slicer da pagina 04) ----------
// O usuario tira o % por regional filtrando UMA regional por vez e lendo o
// Total da tabela "Perda de receita por data". O slicer e' um "button slicer"
// (aria-pressed=true = selecionado, multi-selecao por toggle, itens
// virtualizados -- precisa rolar o .scroll-content para revelar todos).

async function acharContainerRegional(frame) {
  const idx = await frame.evaluate(async () => {
    const bs = [...document.querySelectorAll('.button-slicer-container')];
    for (let i = 0; i < bs.length; i++) {
      const sc = bs[i].querySelector('.scroll-content');
      if (!sc) continue;
      const vistos = new Set();
      for (let pos = 0; pos <= sc.scrollHeight; pos += 40) {
        sc.scrollTop = pos;
        await new Promise((r) => setTimeout(r, 400));
        for (const e of bs[i].querySelectorAll('button, [role="button"]')) {
          const t = (e.innerText || '').trim();
          if (t) vistos.add(t);
        }
      }
      sc.scrollTop = 0;
      if ([...vistos].some((t) => /CENTRO OESTE/i.test(t)) && [...vistos].some((t) => /SP SUL/i.test(t))) return i;
    }
    return -1;
  });
  return idx; // -1 = nao encontrado; quem chama decide o retry/erro
}

async function slicerOperar(frame, idx, op) {
  return frame.evaluate(async ({ idx, op }) => {
    const b = [...document.querySelectorAll('.button-slicer-container')][idx];
    if (!b) return { erro: 'container sumiu' };
    const sc = b.querySelector('.scroll-content');
    const botoes = () => [...b.querySelectorAll('button, [role="button"]')];

    if (op.tipo === 'listar') {
      const itens = new Map(); // nome -> selecionado
      for (let pos = 0; pos <= sc.scrollHeight; pos += 40) {
        sc.scrollTop = pos;
        await new Promise((r) => setTimeout(r, 400));
        for (const e of botoes()) {
          const t = (e.innerText || '').trim();
          if (!t || /^(Select all|Deselect all)$/i.test(t)) continue;
          itens.set(t, e.getAttribute('aria-pressed') === 'true');
        }
      }
      sc.scrollTop = 0;
      await new Promise((r) => setTimeout(r, 300));
      return { itens: [...itens.entries()].map(([nome, sel]) => ({ nome, sel })) };
    }

    // localizar um item pelo nome e devolver o CENTRO do bounding box para
    // click com mouse real (el.click() NAO dispara o handler do PBI -- o
    // button slicer e' virtualizado e so responde a eventos de ponteiro).
    const alvo = op.nome;
    const achar = () => botoes().find((e) => (e.innerText || '').trim() === alvo);
    let el = achar();
    for (let pos = 0; !el && pos <= sc.scrollHeight; pos += 40) {
      sc.scrollTop = pos;
      await new Promise((r) => setTimeout(r, 400));
      el = achar();
    }
    if (!el) return { erro: `botao "${alvo}" nao encontrado` };
    // garante o botao dentro da area visivel do slicer
    const br = b.getBoundingClientRect();
    let r2 = el.getBoundingClientRect();
    for (let k = 0; k < 25 && (r2.bottom > br.bottom - 5 || r2.top < br.top); k++) {
      sc.scrollTop += (r2.top < br.top ? -40 : 40);
      await new Promise((r) => setTimeout(r, 400));
      const el2 = achar();
      if (!el2) return { erro: `botao "${alvo}" sumiu durante o scroll` };
      el = el2;
      r2 = el.getBoundingClientRect();
    }
    return { x: r2.x + r2.width / 2, y: r2.y + r2.height / 2, nome: alvo };
  }, { idx, op });
}

// Click real com mouse (Playwright) no ponto devolvido por slicerOperar.
async function slicerClicar(frame, page, idx, nome) {
  const r = await slicerOperar(frame, idx, { tipo: 'localizar', nome });
  if (r.erro) return r;
  await page.mouse.click(r.x, r.y);
  return { clicado: nome };
}

async function lerTotalPorData(frame) {
  const txt = await frame.locator('body').innerText();
  const i = txt.indexOf('Perda de receita por data');
  if (i < 0) return null;
  const m = txt.slice(i, i + 3000).match(/Total\n\s*\n?(R\$ [\d.,]+)\n([\d.,]+)%/);
  if (!m) return null;
  return { perda: m[1], pct: parseFloat(m[2]) };
}

// Le a tabela "Perda de receita por data" inteira (linhas por dia + Total).
// Usada na iteracao por regional para capturar o array diario de cada uma.
async function lerTabelaPorData(frame) {
  const txt = await frame.locator('body').innerText();
  const i = txt.indexOf('Perda de receita por data');
  if (i < 0) return null;
  const fim = txt.indexOf('Perda de receita por subcategoria', i);
  const secao = txt.slice(i, fim > i ? fim : i + 20000);
  const linhas = secao.split('\n').map((l) => l.trim());
  const linhaRe = /^(\d{1,2}\/\d{1,2}\/\d{4})$/;
  const dinheiroRe = /^R\$\s?[\d.,]+$/;
  const pctRe = /^[\d.,]+%$/;
  const porData = [];
  for (let k = 0; k < linhas.length; k++) {
    if (linhaRe.test(linhas[k]) && dinheiroRe.test(linhas[k + 2] || '') && pctRe.test(linhas[k + 3] || '')) {
      porData.push({ data: linhas[k], perda: linhas[k + 2], pct: linhas[k + 3] });
      k += 3;
    }
  }
  const totalMatch = secao.match(/Total\n\s*\n?(R\$ [\d.,]+)\n([\d.,]+)%/);
  return { porData, total: totalMatch ? { perda: totalMatch[1], pct: parseFloat(totalMatch[2]) } : null };
}

// Espera o relatorio recalcular e ESTABILIZAR: o total precisa mudar em
// relacao ao anterior E se manter igual por duas leituras seguidas (3s de
// intervalo). Valores intermediarios do recalculo sao descartados.
async function esperarRecalculo(frame, anterior) {
  const inicio = Date.now();
  let ultimo = null;
  let iguais = 0;
  while (Date.now() - inicio < 40000) {
    await new Promise((r) => setTimeout(r, 3000));
    const atual = await lerTotalPorData(frame);
    if (!atual) continue;
    const mudou = !anterior || atual.perda !== anterior.perda || atual.pct !== anterior.pct;
    if (!mudou) { ultimo = null; iguais = 0; continue; }
    if (ultimo && atual.perda === ultimo.perda && atual.pct === ultimo.pct) {
      iguais++;
      if (iguais >= 1) return atual; // estavel
    } else {
      ultimo = atual;
      iguais = 0;
    }
  }
  return ultimo || lerTotalPorData(frame);
}

// Extrai pct (e perda R$) por regional na pagina 04. Restaura o filtro ao
// estado original ao final. Falhas por regional sao registradas e seguem.
async function extrairPctPorRegional(frame, page) {
  // espera a tabela por data renderizar e o slicer aparecer (retry)
  await esperarTexto(frame, 'Perda de receita por data', 40000).catch(() => {});
  // o slicer e' "deferred rendering": pode levar ~1min apos trocar de aba.
  // Espera ate algum container ter botoes suficientes (lista completa) antes
  // de procurar o de Regional.
  let idx = -1;
  for (let tent = 0; tent < 12 && idx < 0; tent++) {
    idx = await acharContainerRegional(frame);
    if (idx < 0) {
      await page.mouse.move(600, 400).catch(() => {});
      await page.waitForTimeout(6000);
    }
  }
  if (idx < 0) throw new Error('button slicer de Regional nao encontrado');
  logInfo('slicer regional localizado', { container: idx });

  const { itens } = await slicerOperar(frame, idx, { tipo: 'listar' });
  if (!itens || itens.length === 0) throw new Error('nenhum item no slicer regional');
  const selecionadosOriginais = itens.filter((i) => i.sel).map((i) => i.nome);
  logInfo('itens do slicer', { total: itens.length, selecionados: selecionadosOriginais });

  const limpar = async () => {
    // "Deselect all" so existe quando ha selecao; se so houver "Select all",
    // ja esta limpo (nada selecionado = All). JAMAIS clicar "Select all"
    // (isso selecionaria TUDO e inverteria a logica dos toggles).
    for (let tent = 0; tent < 3; tent++) {
      const r = await slicerClicar(frame, page, idx, 'Deselect all');
      if (!r.erro) { await page.waitForTimeout(3000); return; }
      const soSelectAll = await slicerOperar(frame, idx, { tipo: 'localizar', nome: 'Select all' });
      if (!soSelectAll.erro) return; // ja esta limpo
      await page.waitForTimeout(3000);
    }
    // fallback final: desliga um a um os que estiverem marcados
    const est = await slicerOperar(frame, idx, { tipo: 'listar' });
    for (const i of (est.itens || []).filter((x) => x.sel)) {
      await slicerClicar(frame, page, idx, i.nome);
      await page.waitForTimeout(1500);
    }
    await page.waitForTimeout(2000);
  };

  await limpar();
  const pctPorRegional = {};
  const perdaPorRegional = {};
  const perdaDiariaPorRegional = {};
  const falhas = {};

  for (const { nome } of itens) {
    try {
      const antes = await lerTotalPorData(frame);
      let click = await slicerClicar(frame, page, idx, nome);
      if (click.erro) { falhas[nome] = click.erro; continue; }
      let leitura = await esperarRecalculo(frame, antes);
      // se nao recalculou (click nao pegou), tenta de novo uma vez
      if (!leitura || (antes && leitura.perda === antes.perda && leitura.pct === antes.pct)) {
        logInfo('sem recalculo; retentando click', { nome });
        click = await slicerClicar(frame, page, idx, nome);
        if (click.erro) { falhas[nome] = click.erro; continue; }
        leitura = await esperarRecalculo(frame, antes);
      }
      if (!leitura || (antes && leitura.perda === antes.perda && leitura.pct === antes.pct)) {
        falhas[nome] = 'total nao mudou apos filtro';
        continue;
      }
      pctPorRegional[normalizarRegional(nome)] = leitura.pct;
      perdaPorRegional[normalizarRegional(nome)] = leitura.perda;
      // captura o array diario da regional (mesma tabela, ja estabilizada)
      const tab = await lerTabelaPorData(frame);
      if (tab && tab.porData.length > 0) {
        perdaDiariaPorRegional[normalizarRegional(nome)] = tab.porData;
      } else {
        falhas[nome] = (falhas[nome] ? falhas[nome] + '; ' : '') + 'array diario nao capturado';
      }
      logInfo('regional lida', { nome, pct: leitura.pct, perda: leitura.perda });
      // desliga a regional antes da proxima
      await slicerClicar(frame, page, idx, nome);
      await esperarRecalculo(frame, leitura); // espera voltar ao total cheio
    } catch (e) {
      falhas[nome] = e.message.slice(0, 120);
    }
  }

  // Restaura o filtro para "All" (nada selecionado) -- estado normal do
  // relatorio. NAO re-seleciona o que estava: a leitura de aria-pressed sob
  // virtualizacao nao e' confiavel e ja causou restauracao errada.
  await limpar();
  await page.waitForTimeout(8000);
  logInfo('filtro restaurado para All', { selecionadosNoInicio: selecionadosOriginais });

  return { pctPorRegional, perdaPorRegional, perdaDiariaPorRegional, falhas };
}

// ---------- main ----------

(async () => {
  fs.mkdirSync(RAW_DIR, { recursive: true });
  const stamp = stampData();
  logInfo('iniciando extracao', { stamp, cdp: CDP });

  const browser = await chromium.connectOverCDP(CDP);
  const context = browser.contexts()[0];
  const page = context.pages().find((p) => p.url().includes('app.powerbi.com'));
  if (!page) fatal('aba app.powerbi.com nao encontrada no Chrome depuravel');
  logInfo('aba encontrada', { url: page.url().slice(0, 120) });

  // 2. F5 + espera adaptativa ate renderizar
  await page.reload({ waitUntil: 'domcontentloaded' }).catch((e) => logInfo('reload aviso', { erro: e.message.slice(0, 120) }));
  const frame = page.frames()[0];
  // Marcador exige a TABELA, nao o titulo do menu lateral ("Perda de receita"
  // sozinho aparece cedo demais, antes dos dados renderizarem).
  // Apos F5 o Power BI volta na ULTIMA aba vista, nao na padrao -- entao a
  // espera inicial so confirma que o app renderizou (menu lateral presente).
  // A visao por data NAO e' a aba inicial: ela vive na pagina "04. DashBoard"
  // (confirmado por varredura em 18/08/2026).
  await esperarTexto(frame, 'Perda de receita', RELOAD_TIMEOUT_MS)
    .catch((e) => fatal('relatorio nao renderizou apos F5', { erro: e.message }));
  await page.waitForTimeout(5000);
  logInfo('relatorio renderizado apos reload');

  const saidas = {};
  const abas = [
    { rotulo: 'por-data', arquivo: `por-data-${stamp}.txt`, regex: /04\. DashBoard/i, marcador: 'Perda de receita por data' },
    { rotulo: 'tab-resumo-bkb', arquivo: `tab-resumo-bkb-${stamp}.txt`, regex: /01\. Tab\. resumo BKB/i, marcador: 'PERDA: REGIONAL' },
    { rotulo: 'visao-bkb-diretorias', arquivo: `visao-bkb-diretorias-${stamp}.txt`, regex: /VIS.{0,3}O BKB DIRETORIAS/i, marcador: 'DIRETORIA' },
  ];

  // A aba por-data vem primeiro e a etapa do slicer Regional roda LOGO em
  // seguida: navegar por outras abas antes degrada a renderizacao "deferred"
  // do button slicer (ele some do DOM e nao volta a tempo). Ordem testada.
  let regPct = { pctPorRegional: {}, perdaPorRegional: {}, perdaDiariaPorRegional: {}, falhas: { etapa: 'nao executada' } };

  for (const aba of abas) {
    await clicarAba(frame, aba.regex, aba.rotulo).catch((e) => fatal(e.message));
    await page.waitForTimeout(WAIT_RENDER_MS);
    // espera adaptativa extra pelo marcador da aba (best effort, nao fatal)
    let txt;
    try {
      txt = await esperarTexto(frame, aba.marcador, 20000);
    } catch {
      txt = await innerTextFrame(frame);
      logInfo('marcador da aba nao apareceu; usando texto mesmo assim', { aba: aba.rotulo, marcador: aba.marcador });
    }
    saidas[aba.rotulo] = txt;
    logInfo('aba capturada', { aba: aba.rotulo, chars: txt.length });

    if (aba.rotulo === 'por-data') {
      try {
        regPct = await extrairPctPorRegional(frame, page);
        logInfo('pct por regional extraido', {
          lidas: Object.keys(regPct.pctPorRegional).length,
          falhas: Object.keys(regPct.falhas).length,
        });
        // a iteracao do slicer mexe na tabela; recaptura o raw ja sem filtro
        saidas['por-data'] = await innerTextFrame(frame);
      } catch (e) {
        logErro('extracao por regional falhou (seguindo sem ela)', { erro: e.message.slice(0, 200) });
        regPct = { pctPorRegional: {}, perdaPorRegional: {}, perdaDiariaPorRegional: {}, falhas: { etapa: e.message.slice(0, 200) } };
      }
      // A tabela e virtualizada: rola ate o fim e mescla os dias que ficaram
      // fora da janela visivel (sem isso os ultimos dias do mes se perdem).
      saidas['por-data'] = await mesclarPorDataCompleta(frame, saidas['por-data']);
    }
  }

  // 4. Salva raws
  for (const aba of abas) {
    const p = path.join(RAW_DIR, aba.arquivo);
    fs.writeFileSync(p, saidas[aba.rotulo], 'utf8');
    logInfo('raw salvo', { arquivo: p, chars: saidas[aba.rotulo].length });
  }

  // 5. Extrai resumo estruturado
  let resumo;
  try {
    const { porData, total } = parsePorData(saidas['por-data']);
    const { regionais: regionaisMtd } = parseRegionalMtd(saidas['tab-resumo-bkb']);
    resumo = {
      geradoEm: agora(),
      atualizadoEm: parseAtualizadoEm(saidas['por-data']),
      perdaPorData: porData,
      total,
      porRegional: regionaisMtd,
      pctPorRegional: regPct.pctPorRegional,
      perdaPorRegional: regPct.perdaPorRegional,
      perdaDiariaPorRegional: regPct.perdaDiariaPorRegional,
      pctPorRegionalFalhas: Object.keys(regPct.falhas).length ? regPct.falhas : undefined,
    };
  } catch (e) {
    fatal('falha ao extrair resumo estruturado', { erro: e.message });
  }

  const pResumo = path.join(RAW_DIR, `resumo-${stamp}.json`);
  fs.writeFileSync(pResumo, JSON.stringify(resumo, null, 2), 'utf8');
  logInfo('resumo salvo', {
    arquivo: pResumo,
    datas: resumo.perdaPorData.length,
    regionais: resumo.porRegional.length,
    atualizadoEm: resumo.atualizadoEm,
  });
  logInfo('extracao concluida com sucesso');
  process.exit(0);
})().catch((e) => fatal('erro inesperado', { erro: e.message.slice(0, 300) }));
